{
  "name": "dsh-graphlint",
  "version": "0.6.0",
  "description": "DeepSeek Harness plugin bundle: graphlint dead-code detection tools for agents (graphlint_query / graphlint_build / graphlint_config + graphlint skill).",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "graphlint",
    "dead-code",
    "static-analysis",
    "dependency-graph",
    "lint"
  ],
  "license": "MIT",
  "author": "Yutong Zou <yutong.zou.24@alumni.ucl.ac.uk> (https://github.com/AngelosZou)",
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./invariant": {
      "types": "./lib/src/invariant.d.ts",
      "default": "./lib/src/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "node scripts/generate-skill.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test \"lib/test/**/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngelosZou/graphlint.git",
    "directory": "integrations/dsh"
  },
  "bugs": {
    "url": "https://github.com/AngelosZou/graphlint/issues"
  },
  "homepage": "https://github.com/AngelosZou/graphlint/tree/main/integrations/dsh#readme"
}
